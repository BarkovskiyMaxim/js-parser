{
  "name": "js-code-parser",
  "version": "0.0.1",
  "author": {
    "email": "barkovskiy.max@gmail.com",
    "name": "BarkovskiyMaxim"
  },
  "homepage": "https://github.com/BarkovskiyMaxim/js-parser",
  "license": "MIT",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "SECURITY.md",
    "docs/knockout-aot.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./runtime": {
      "import": {
        "types": "./dist/runtime.d.mts",
        "default": "./dist/esm/runtime.js"
      },
      "require": {
        "types": "./dist/runtime.d.ts",
        "default": "./dist/runtime.js"
      }
    },
    "./executors/*": {
      "require": {
        "types": "./dist/executors/*.d.ts",
        "default": "./dist/executors/*.js"
      }
    },
    "./parser/*": {
      "require": {
        "types": "./dist/parser/*.d.ts",
        "default": "./dist/parser/*.js"
      }
    },
    "./operands/*": {
      "require": {
        "types": "./dist/operands/*.d.ts",
        "default": "./dist/operands/*.js"
      }
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/babel__generator": "^7.27.0",
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "jison": "0.4.18",
    "jsdom": "^27.0.0",
    "knockout": "^3.5.3",
    "playwright-core": "^1.62.1",
    "publint": "^0.3.23",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json && node scripts/copy-parser.mjs && node scripts/build-esm.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint sources __tests__ tests scripts vitest.config.mts",
    "lint:package": "publint",
    "verify:package": "npm run build && npm run lint:package && node scripts/verify-package.mjs",
    "build:browser-fixture": "node scripts/build-browser-fixture.mjs",
    "verify:browser": "node scripts/verify-browser-csp.mjs",
    "verify:dynamic-code": "npm run build:browser-fixture && node scripts/check-dynamic-code.mjs",
    "verify": "npm run typecheck && npm run lint && npm test && npm run verify:package && npm run verify:browser && npm run verify:dynamic-code"
  },
  "dependencies": {
    "@babel/generator": "^7.29.8",
    "@babel/parser": "^7.29.8",
    "@babel/traverse": "^7.29.8",
    "@babel/types": "^7.29.8"
  }
}
