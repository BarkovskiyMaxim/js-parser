{
  "name": "js-code-parser",
  "version": "0.0.1",
  "author": {
    "email": "barkovskiy.max@gmail.com",
    "name": "BarkovskiyMaxim"
  },
  "homepage": "https://github.com/BarkovskiyMaxim/js-parser",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js"
    },
    "./executors/*": {
      "types": "./dist/executors/*.d.ts",
      "require": "./dist/executors/*.js"
    },
    "./parser/*": {
      "types": "./dist/parser/*.d.ts",
      "require": "./dist/parser/*.js"
    },
    "./operands/*": {
      "types": "./dist/operands/*.d.ts",
      "require": "./dist/operands/*.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "eslint": "^9.39.5",
    "jison": "0.4.18",
    "jsdom": "^27.0.0",
    "knockout": "^3.5.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json && node scripts/copy-parser.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint sources __tests__ tests vitest.config.mts"
  }
}
